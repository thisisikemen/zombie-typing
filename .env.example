# 公開URL。独自ドメイン取得後は https://your-domain.example/ に変更する。
SITE_URL=https://thisisikemen.github.io/zombie-typing/
# GA4 のウェブストリームの測定ID。空なら通信も同意画面も発生しない。
VITE_GA_MEASUREMENT_ID=
# AdSense所有確認用。実際の ca-pub- と16桁。タグ配信は開始しない。
ADSENSE_PUBLISHER_ID=

# Google OAuth・記録同期SQLの適用と公開前検証が完了してから有効化。
VITE_ACCOUNTS_ENABLED=false
