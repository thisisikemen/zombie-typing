# 正式公開URL。
SITE_URL=https://zombietyping.jp/
# GA4 のウェブストリームの測定ID。空なら通信も同意画面も発生しない。
VITE_GA_MEASUREMENT_ID=
# AdSense所有確認用。実際の ca-pub- と16桁。タグ配信は開始しない。
ADSENSE_PUBLISHER_ID=

# 任意のGoogleログイン。本番のOAuth・記録同期SQLは設定済み。
VITE_ACCOUNTS_ENABLED=true

# Googleがテスト公開の間の画面案内。本番公開と実登録の確認後にfalse。
VITE_ACCOUNTS_TEST_MODE=false

# 独自SMTP・番号入りメール・実配信の確認後だけtrue
VITE_EMAIL_AUTH_ENABLED=false
