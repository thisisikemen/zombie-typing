{
  "name": "zombie-typing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-site.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:hosting-preview": "node scripts/build-cloudflare.mjs --preview",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ranking-security": "node scripts/check-ranking-security.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
