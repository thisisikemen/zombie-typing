{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zombie-typing",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "zombietyping.jp",
      "custom_domain": true
    }
  ]
}
